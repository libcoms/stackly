[Unit]
Description=stackly API (регистрация, вход, прогресс)
After=network-online.target
Wants=network-online.target

[Service]
User=stackly
Group=stackly
EnvironmentFile=/etc/stackly/stackly.env
ExecStart=/usr/bin/python3 /opt/stackly/app/stackly_api.py
Restart=on-failure
RestartSec=3
# ограничения: сервис видит только свою папку с базой
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/stackly
MemoryMax=300M

[Install]
WantedBy=multi-user.target
