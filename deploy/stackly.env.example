# /etc/stackly/stackly.env — настройки API (права 600, владелец root)
STACKLY_DB=/var/lib/stackly/stackly.db
STACKLY_HOST=127.0.0.1
STACKLY_PORT=8090
STACKLY_ORIGIN=https://DOMAIN
STACKLY_COOKIE_SECURE=1

# Почта для восстановления пароля (например, ящик на Reg.ru: smtp.reg.ru, порт 465)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Telegram-бот для преподавателей (сервис stackly-bot). Создайте бота у @BotFather и впишите токен и имя бота без @,
# затем: systemctl restart stackly-api stackly-bot
STACKLY_TG_TOKEN=
STACKLY_TG_BOT=

# Оплата тарифа Про через ЮKassa: shopId и секретный ключ из личного кабинета ЮKassa (раздел «Интеграция»).
# В кабинете ЮKassa укажите адрес для уведомлений https://DOMAIN/api/pay/webhook (событие payment.succeeded),
# затем: systemctl restart stackly-api. Пока поля пустые, кнопки оплаты на сайте не показываются.
STACKLY_YK_SHOP=
STACKLY_YK_KEY=

# Разбор кода с ИИ (задачи банка, которые решают на Python): модель разбирает код ученика и отвечает голосом,
# дальше можно разговаривать. Все модели — через RouterAI (https://routerai.ru, ключ в личном кабинете).
# Пока ключа нет, функции на сайте не видно. Затем: systemctl restart stackly-api
STACKLY_AI_KEY=
# кому открыт разбор — почты через запятую
STACKLY_AI_USERS=dglumov4@gmail.com
# минуты звука в неделю на человека (речь ученика + ответы голосом), в секундах
STACKLY_AI_WEEK_SECONDS=600
# модели RouterAI: разбор, распознавание речи, озвучка и голос (по умолчанию — как ниже)
#STACKLY_AI_MODEL=anthropic/claude-sonnet-5.5
#STACKLY_AI_STT=openai/whisper-large-v3-turbo
#STACKLY_AI_TTS=google/gemini-3.8-flash-tts
#STACKLY_AI_VOICE=Kore
