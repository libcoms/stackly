# /etc/stackly/stackly.env — настройки API (права 600, владелец root)
STACKLY_DB=/var/lib/stackly/stackly.db
STACKLY_HOST=127.0.0.1
STACKLY_PORT=8090
STACKLY_ORIGIN=https://DOMAIN
STACKLY_COOKIE_SECURE=1

# Почта для восстановления пароля (например, ящик на Reg.ru: smtp.reg.ru, порт 465)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Telegram-бот для преподавателей (сервис stackly-bot). Создайте бота у @BotFather и впишите токен и имя бота без @,
# затем: systemctl restart stackly-api stackly-bot
STACKLY_TG_TOKEN=
STACKLY_TG_BOT=

# Оплата тарифа Про через ЮKassa: shopId и секретный ключ из личного кабинета ЮKassa (раздел «Интеграция»).
# В кабинете ЮKassa укажите адрес для уведомлений https://DOMAIN/api/pay/webhook (событие payment.succeeded),
# затем: systemctl restart stackly-api. Пока поля пустые, кнопки оплаты на сайте не показываются.
STACKLY_YK_SHOP=
STACKLY_YK_KEY=
